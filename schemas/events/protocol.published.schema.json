{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kilbowie/ti-verify/schemas/events/protocol.published.schema.json",
  "title": "protocol.published",
  "type": "object",
  "properties": {
    "event": {
      "const": "protocol.published"
    },
    "scheme": {
      "const": "ti-seal-v1"
    },
    "subject_type": {
      "const": "protocol"
    },
    "subject_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "document": {
      "const": "TI Human Verification Protocol"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "document_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    }
  },
  "required": [
    "event",
    "scheme",
    "subject_type",
    "subject_hash",
    "document",
    "version",
    "document_sha256",
    "url"
  ],
  "additionalProperties": false
}
