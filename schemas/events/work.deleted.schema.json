{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kilbowie/ti-verify/schemas/events/work.deleted.schema.json",
  "title": "work.deleted",
  "type": "object",
  "properties": {
    "event": {
      "const": "work.deleted"
    },
    "scheme": {
      "const": "ti-seal-v1"
    },
    "subject_type": {
      "const": "work"
    },
    "subject_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "event",
    "scheme",
    "subject_type",
    "subject_hash"
  ],
  "additionalProperties": false
}
